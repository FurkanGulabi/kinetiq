{
  "name": "kinetiq",
  "version": "0.1.0",
  "description": "Kinetiq — Advanced Motion Control. A modern control interface for GRBL-compatible CNC machines.",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude ./src/app --exclude ./src/components --exclude ./src/lib server.ts",
    "build": "next build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@serialport/parser-readline": "^10.0.0",
    "chalk": "~4.1.1",
    "ensure-type": "^1.5.1",
    "escodegen": "~1.11.1",
    "esprima": "~4.0.1",
    "gcode-parser": "^2.2.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "~4.17.11",
    "lucide-react": "^1.70.0",
    "minimatch": "~3.1.4",
    "next": "16.4.5",
    "range_check": "~1.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serialport": "^10.0.0",
    "shortid": "~2.2.14",
    "socket.io": "~2.2.0",
    "socket.io-client": "2.5.0",
    "socketio-jwt": "~4.5.0",
    "spawn-default-shell": "~2.0.0",
    "three": "^0.187.0",
    "watch": "~1.0.2",
    "winston": "~3.14.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
